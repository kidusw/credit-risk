# Copy to .env and fill in. .env is git-ignored.
DATABASE_URL=postgresql+psycopg://crisk:crisk@localhost:5434/crisk
# Optional: a separate database used by the Postgres integration tests
TEST_DATABASE_URL=postgresql+psycopg://crisk:crisk@localhost:5434/crisk_test
KAGGLE_API_TOKEN=
# MLflow tracking store (default: local SQLite file mlflow.db, git-ignored)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
